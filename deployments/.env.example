# Modelo de configuração. Copie para .env e ajuste.
#
# Rodando pelo compose, o .env desta pasta já vem preenchido. Rodando o binário
# direto, copie este arquivo para a raiz do repositório: é lá que a aplicação
# procura o .env quando sobe fora do Docker.

# Porta do servidor HTTP.
WEB_SERVER_PORT=8080

# Estratégia de persistência: redis (padrão) ou memory.
RATE_LIMIT_STORE=redis

# Conexão com o Redis. Dentro do compose o endereço é redis:6379 e vem de lá.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Máximo de requisições por janela para um mesmo IP.
RATE_LIMIT_IP=10

# Limites por token, no formato token:limite separado por vírgula.
# Token que não aparecer aqui cai no limite do IP.
RATE_LIMIT_TOKENS=abc123:100,def456:5

# Tempo de vida da chave de contagem no Redis.
RATE_LIMIT_WINDOW=1s

# Tempo de vida da chave de bloqueio no Redis.
RATE_LIMIT_BLOCK_DURATION=5m
