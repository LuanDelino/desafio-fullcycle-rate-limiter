# Configuração usada pelo docker compose desta pasta.
#
# Está no versionamento de propósito: são políticas de limite, não segredos, e o
# desafio pede que o projeto suba só com Docker. Se um dia entrar credencial de
# verdade aqui (REDIS_PASSWORD em produção, por exemplo), este arquivo sai do git
# e o valor passa a vir do orquestrador.
#
# REDIS_ADDR não aparece aqui: é topologia e está fixo no docker-compose.yml.

WEB_SERVER_PORT=8080
RATE_LIMIT_STORE=redis

REDIS_PASSWORD=
REDIS_DB=0

# Máximo de requisições por janela para um mesmo IP.
RATE_LIMIT_IP=10

# Limites por token, no formato token:limite separado por vírgula.
# Token que não aparecer aqui cai no limite do IP.
RATE_LIMIT_TOKENS=abc123:100,def456:5

# Tempo de vida da chave de contagem no Redis.
RATE_LIMIT_WINDOW=1s

# Tempo de vida da chave de bloqueio no Redis.
RATE_LIMIT_BLOCK_DURATION=5m
