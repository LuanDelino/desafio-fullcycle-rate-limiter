# Porta do servidor HTTP.
WEB_SERVER_PORT=8080

# Estratégia de persistência: redis (padrão) ou memory.
RATE_LIMIT_STORE=redis

# Conexão com o Redis. Use localhost:6379 fora do compose.
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Máximo de requisições por janela para um mesmo IP.
RATE_LIMIT_IP=10

# Limites por token, no formato token:limite separado por vírgula.
# Token que não aparecer aqui é tratado como se não houvesse token.
RATE_LIMIT_TOKENS=abc123:100,def456:5

# Tamanho da janela de contagem.
RATE_LIMIT_WINDOW=1s

# Tempo de bloqueio de quem estourou o limite.
RATE_LIMIT_BLOCK_DURATION=5m
